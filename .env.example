# Copy to .env for local runs. Never commit .env.
TELEGRAM_BOT_TOKEN=
# T4 vision (docs/t4-vision.md); all unset = feature off
VISION_BASE_URL=
VISION_MODEL=
VISION_HOST_ALLOWLIST=
VISION_API_KEY=
VISION_TIMEOUT=
VISION_DAILY_CAP_USD=
# Free-check counter key (D-12): at least 32 random characters; unset or short = vision check off
CHECK_COUNTER_SALT=
# Paid checks launch date, ISO (e.g. 2027-01-15): waitlist rows are deleted 30 days after it (D-14); unset = not launched
PAID_LAUNCH_DATE=
# Per-user daily cap on uncharged checks (NEEDS_REVIEW/UNAVAILABLE), in memory, UTC day; empty = 10 (D-15)
UNCHARGED_DAILY_LIMIT=
# Minutes before the one reminder to send the second photo (1..25); empty = 5
PAIR_REMINDER_MIN=
